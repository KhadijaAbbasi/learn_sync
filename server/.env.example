# Copy to server/.env ONLY if .env does not already exist.
# Do NOT overwrite an existing .env (that wipes GOOGLE_APPLICATION_CREDENTIALS / FIREBASE_API_KEY).
# Prefer:  .\ensure-env.ps1
# Never commit .env or service account JSON.

PORT=3000

# Path to Firebase service account JSON (server-only). Absolute path recommended on Windows.
# Example: D:\secrets\learnsync-firebase-adminsdk.json
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccount.json

GOOGLE_APPLICATION_CREDENTIALS =D:\Documents\Android Studio Projects\\learnsync-bb5e6-firebase-adminsdk-fbsvc-2a08a3b296.json

# Optional alias for the same file:
# FIREBASE_SERVICE_ACCOUNT=path/to/serviceAccount.json

# Firebase Console â†’ Project settings â†’ General â†’ Web API Key
# Used by Express to verify email+password via Identity Toolkit REST.

FIREBASE_API_KEY = AIzaSyBAU-ac-2OL-gAQzV0CVuaeGYmcD8coNGc

# AI practice quiz generation
# Default: proxy deployed Cloud Function generateAiPracticeQuiz (uses caller's ID token).
